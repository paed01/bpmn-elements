{
  "name": "bpmn-elements",
  "version": "18.0.22",
  "description": "Executable workflow elements based on BPMN 2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./src/index.js",
  "jsnext:main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./dist/index.js",
      "import": "./src/index.js"
    },
    "./errors": {
      "types": "./types/index.d.ts",
      "require": "./dist/error/Errors.js",
      "import": "./src/error/Errors.js"
    },
    "./events": {
      "types": "./types/index.d.ts",
      "require": "./dist/events/index.js",
      "import": "./src/events/index.js"
    },
    "./eventDefinitions": {
      "types": "./types/index.d.ts",
      "require": "./dist/eventDefinitions/index.js",
      "import": "./src/eventDefinitions/index.js"
    },
    "./flows": {
      "types": "./types/index.d.ts",
      "require": "./dist/flows/index.js",
      "import": "./src/flows/index.js"
    },
    "./gateways": {
      "types": "./types/index.d.ts",
      "require": "./dist/gateways/index.js",
      "import": "./src/gateways/index.js"
    },
    "./tasks": {
      "types": "./types/index.d.ts",
      "require": "./dist/tasks/index.js",
      "import": "./src/tasks/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "mocha -R @bonniernews/hot-bev -p -t 3000",
    "posttest": "npm run lint && npm run dist && npm run typecheck",
    "lint": "eslint . --cache && prettier . --check --cache",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "prepack": "npm run dist",
    "test:md": "texample ./docs/Examples.md,./docs/StartEvent.md,./docs/Extension.md,./docs/ConditionalEventDefinition.md",
    "cov:html": "c8 -r html -r text mocha -R @bonniernews/hot-bev -p -t 3000",
    "test:lcov": "c8 -r lcov mocha && npm run lint",
    "dist": "babel src -d dist/ && npm run build:types",
    "build:types": "node scripts/build-types.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/paed01/bpmn-elements.git"
  },
  "author": {
    "name": "Pål Edman",
    "url": "https://github.com/paed01"
  },
  "license": "MIT",
  "keywords": [
    "workflow",
    "automation",
    "bpmn",
    "bpmn 2",
    "isomorphic",
    "tree-shakeable"
  ],
  "files": [
    "dist",
    "src",
    "types",
    "!types/bundle.d.ts",
    "!types/bundle-errors.d.ts",
    "!types/interfaces.d.ts",
    "*.d.ts"
  ],
  "c8": {
    "include": [
      "src/**/*"
    ]
  },
  "overrides": {
    "mocha": {
      "yargs": "^18.0.0"
    }
  },
  "devDependencies": {
    "@aircall/expression-parser": "^1.0.4",
    "@babel/cli": "^7.24.1",
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@babel/register": "^7.23.7",
    "@bonniernews/hot-bev": "^0.4.0",
    "@eslint/js": "^10.0.1",
    "@types/bpmn-moddle": "^10.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.40",
    "bpmn-moddle": "^10.0.0",
    "c8": "^12.0.0",
    "camunda-bpmn-moddle": "^7.0.1",
    "chai": "^6.2.1",
    "chronokinesis": "^8.0.0",
    "debug": "^4.3.4",
    "dts-buddy": "^0.8.3",
    "eslint": "^10.3.0",
    "globals": "^17.0.0",
    "mocha": "^11.0.1",
    "mocha-cakes-2": "^3.3.0",
    "moddle-context-serializer": "^6.0.0",
    "nock": "^14.0.0",
    "prettier": "^3.2.5",
    "texample": "^1.0.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@0dep/piso": "^5.0.0",
    "smqp": "^13.1.0"
  }
}
