      <bpmn:outgoing>Flow_1ToTask1</bpmn:outgoing>
      <bpmn:outgoing>Flow_1To2</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="Activity_1" name="1">
