    <bpmn:sequenceFlow id="Flow_StartTo1" sourceRef="Event_Start" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_1ToTask1" sourceRef="Gateway_1" targetRef="Activity_1" />
    <bpmn:sequenceFlow id="Flow_Task1ToEnd1" sourceRef="Activity_1" targetRef="Event_End1" />
    <bpmn:sequenceFlow id="Flow_1To2" sourceRef="Gateway_1" targetRef="Gateway_2" />
