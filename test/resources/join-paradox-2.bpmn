      <bpmn:incoming>to-task5</bpmn:incoming>
      <bpmn:outgoing>from-task5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="start" name="">
      <bpmn:outgoing>to-gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="to-gw" sourceRef="start" targetRef="gw" />
