  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:task id="task1" name="task1">
      <bpmn:incoming>from-task3</bpmn:incoming>
      <bpmn:incoming>to-task1</bpmn:incoming>
      <bpmn:outgoing>to-task2</bpmn:outgoing>
      <bpmn:outgoing>to-task4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task2" name="Task 2">
      <bpmn:incoming>to-task2</bpmn:incoming>
      <bpmn:outgoing>from-task2</bpmn:outgoing>
      <bpmn:outgoing>backto-task3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task3" name="task3">
      <bpmn:incoming>backto-task3</bpmn:incoming>
      <bpmn:outgoing>from-task3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task4" name="task4">
      <bpmn:incoming>to-task4</bpmn:incoming>
      <bpmn:outgoing>from-task4</bpmn:outgoing>
      <bpmn:outgoing>to-task5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="">
      <bpmn:incoming>to-end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="join" name="join">
      <bpmn:incoming>from-task2</bpmn:incoming>
      <bpmn:incoming>from-task4</bpmn:incoming>
      <bpmn:incoming>from-task5</bpmn:incoming>
      <bpmn:outgoing>to-fork</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="fork">
      <bpmn:incoming>to-fork</bpmn:incoming>
      <bpmn:outgoing>from-fork-1</bpmn:outgoing>
      <bpmn:outgoing>to-fork-task2</bpmn:outgoing>
      <bpmn:outgoing>to-fork-task5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="join-fork">
      <bpmn:incoming>from-fork-1</bpmn:incoming>
      <bpmn:incoming>from-fork-task1</bpmn:incoming>
      <bpmn:incoming>from-fork-task2</bpmn:incoming>
      <bpmn:outgoing>to-loopback</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="fork-task1" name="Fork task 1">
      <bpmn:incoming>to-fork-task5</bpmn:incoming>
      <bpmn:outgoing>from-fork-task1</bpmn:outgoing>
    </bpmn:task>
