      <bpmn:outgoing>from-task4</bpmn:outgoing>
      <bpmn:outgoing>back2-task3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="to-task4" sourceRef="task3" targetRef="task4" />
    <bpmn:sequenceFlow id="from-task4" sourceRef="task4" targetRef="join" />
    <bpmn:sequenceFlow id="from-task2" sourceRef="task2" targetRef="join" />
    <bpmn:sequenceFlow id="back2-task3" sourceRef="task4" targetRef="task3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${environment.services.takeOnce()}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:parallelGateway id="join" name="Join">
      <bpmn:incoming>from-task4</bpmn:incoming>
      <bpmn:incoming>from-task2</bpmn:incoming>
      <bpmn:outgoing>to-task5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="task5" name="Task 5">
      <bpmn:incoming>to-task5</bpmn:incoming>
      <bpmn:outgoing>back2-task1</bpmn:outgoing>
      <bpmn:outgoing>to-fork</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="to-task5" sourceRef="join" targetRef="task5" />
    <bpmn:sequenceFlow id="back2-task1" sourceRef="task5" targetRef="task1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${environment.services.takeOnce()}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="to-fork" sourceRef="task5" targetRef="fork" />
    <bpmn:parallelGateway id="fork" name="Fork">
      <bpmn:incoming>to-fork</bpmn:incoming>
      <bpmn:outgoing>to-task6</bpmn:outgoing>
      <bpmn:outgoing>to-task7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="task6" name="Task 6">
