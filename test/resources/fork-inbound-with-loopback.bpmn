      <bpmn:outgoing>from-task7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="to-task7" sourceRef="fork" targetRef="task7" />
    <bpmn:endEvent id="end">
      <bpmn:incoming>to-end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="from-task7" sourceRef="task7" targetRef="join2" />
    <bpmn:sequenceFlow id="from-task6" sourceRef="task6" targetRef="join2" />
    <bpmn:inclusiveGateway id="split">
      <bpmn:incoming>to-split</bpmn:incoming>
      <bpmn:outgoing>to-task1</bpmn:outgoing>
      <bpmn:outgoing>to-task3</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="to-end" sourceRef="join2" targetRef="end" />
    <bpmn:parallelGateway id="join2">
